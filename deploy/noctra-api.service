[Unit]
Description=NOCTRA lead form to Telegram
After=network-online.target
Wants=network-online.target

[Service]
User=www-data
Group=www-data
EnvironmentFile=-/etc/noctra/telegram.env
ExecStart=/usr/bin/python3 /opt/noctra/app.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
